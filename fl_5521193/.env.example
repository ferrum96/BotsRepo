# --- database ---
# Для `npm run demo` не нужен: поднимается встроенный PGlite.
# DATABASE_URL=postgres://astro:astro@localhost:5433/astrostone

# --- api ---
API_PORT=5521
NODE_ENV=development
LOG_LEVEL=debug
DEMO_MODE=true
SESSION_SECRET=change-me-32-chars-minimum-secret

# --- outreach limits (R7) ---
DEFAULT_DAILY_LIMIT_PER_CHANNEL=20
DEFAULT_DAILY_LIMIT_PER_MANAGER=20
SEND_WINDOW_FROM=10:00
SEND_WINDOW_TO=19:00
SEND_JITTER_MIN_SECONDS=60
SEND_JITTER_MAX_SECONDS=180
DEFAULT_TIMEZONE=Europe/Moscow

# --- messaging transport ---
# stub  = in-memory provider, ничего никуда не уходит (dev/demo/tests)
# amochats = реальный шлюз через amoCRM (Wazzup/Radist), см. docs/02-critical.md R1
MESSAGING_PROVIDER=stub

# --- amoCRM ---
# stub = локальный фейк, реальные вызовы не выполняются
# live = POST /api/v4/contacts + /api/v4/leads, токены в data/amocrm-tokens.json
AMOCRM_MODE=stub
AMOCRM_BASE_URL=https://XXXX.amocrm.ru
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://localhost:5521/api/integrations/amocrm/callback
AMOCRM_TOKEN_FILE=
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
AMOCRM_RATE_LIMIT_RPS=5

# --- observability ---
SENTRY_DSN=
