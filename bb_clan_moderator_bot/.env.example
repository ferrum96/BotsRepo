BOT_TOKEN=your_bot_token_here
ADMIN_IDS=your_admin_id_here
GROUP_ID=your_group_id_here
TELEGRAM_GROUP_LINK=your_group_link_here
DISCORD_LINK=your_discord_link_here
# Quote if value has | or spaces (bash `source .env` / deploy.sh).
ADMIN_CONTACT_USERNAME='@admin1,@admin2'
# Optional labels: 'Name|@admin1,Other|@admin2'
DATABASE_PATH=data/bot.db
MAX_SURVEY_ATTEMPTS=2
DASHBOARD_PORT=8080
DASHBOARD_API_KEY=change_me
# Bot → API event push for live WebSocket dashboard (host network → published API port).
DASHBOARD_EVENTS_URL=http://127.0.0.1:8081
GROUP_SYNC_INTERVAL_MINUTES=10
# Full group member list (Telethon). Get api_id/api_hash at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Auto-import all participants when members table is empty (default: on).
FULL_MEMBER_SYNC_ON_EMPTY=1
# Force full import on every bot start / deploy (then unset).
# FULL_MEMBER_SYNC=1

