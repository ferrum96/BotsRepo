BOT_TOKEN=8929212892:AAEooo0urY0rTOYIMy-xa2wrtlpqsLvF2n0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Inside docker-compose the hostname is postgres/redis.
# From the host, use the published ports below.
DATABASE_URL=postgresql+asyncpg://astro:astro@127.0.0.1:55432/astro
REDIS_URL=redis://127.0.0.1:56379/0

# Telegram invoice currency is Stars (XTR), not RUB.
# 299 ₽/мес is the product price; set the Stars amount that matches it in BotFather.
PRO_PRICE_STARS=150
PRO_PERIOD_DAYS=30

# Public HTTPS origin of this service. Required for the Mini App button.
WEBAPP_URL=
WEBHOOK_URL=
WEBHOOK_SECRET=

APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

FREE_TAROT_PER_DAY=1
FREE_AI_PER_DAY=1
CHAT_HISTORY_LIMIT=10

# Local Mini App debugging only. Never enable in production.
ALLOW_INSECURE_INIT_DATA=false
NOMINATIM_USER_AGENT=astro-telegram-bot/0.1
