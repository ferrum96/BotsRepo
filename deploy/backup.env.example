# SQLite backup configuration for Backblaze B2.
# Copy this file to deploy/backup.env and fill in the secrets.
# Job-specific variables (KANBAN_BACKUP_*, BB_CLAN_BACKUP_*) override BACKUP_* defaults.

# Common defaults for all jobs
BACKUP_JOBS=kanban
BACKUP_RETENTION_DAYS=7

# Backblaze B2 common credentials for all jobs
BACKUP_B2_BUCKET=YOUR_BUCKET
BACKUP_B2_KEY_ID=YOUR_KEY_ID
BACKUP_B2_APP_KEY=YOUR_APP_KEY
BACKUP_B2_ENDPOINT=https://s3.YOUR_REGION.backblazeb2.com

# Kanban board
KANBAN_BACKUP_ENABLED=false
KANBAN_BACKUP_DB_PATH=/root/BotsRepo/kanban_board/data/kanban.db
KANBAN_BACKUP_LOCAL_DIR=/var/backups/kanban
# Override common settings if needed:
# KANBAN_BACKUP_B2_BUCKET=kanban-backups

# BB Clan bot (add BB_CLAN to BACKUP_JOBS to enable)
# BB_CLAN_BACKUP_ENABLED=false
# BB_CLAN_BACKUP_DB_PATH=/root/BotsRepo/bb_clan_moderator_bot/data/bot.db
# BB_CLAN_BACKUP_LOCAL_DIR=/var/backups/bb-clan
# BB_CLAN_BACKUP_B2_BUCKET=bb-clan-backups
