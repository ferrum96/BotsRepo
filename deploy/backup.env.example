# SQLite backup configuration for Google Drive.
# Copy this file to deploy/backup.env and fill in the secrets for each job.

# Comma-separated list of backup jobs. For each job define *_BACKUP_* variables below.
BACKUP_JOBS=kanban

# Kanban board
KANBAN_BACKUP_ENABLED=false
KANBAN_BACKUP_DB_PATH=/root/BotsRepo/kanban_board/data/kanban.db
KANBAN_BACKUP_LOCAL_DIR=/var/backups/kanban
KANBAN_BACKUP_GDRIVE_FOLDER_ID=YOUR_FOLDER_ID
# Path to Google credentials JSON: service account key OR OAuth refresh token file.
KANBAN_BACKUP_GDRIVE_SERVICE_ACCOUNT=/root/BotsRepo/deploy/secrets/gdrive-oauth.json
KANBAN_BACKUP_RETENTION_DAYS=7

# BB Clan bot (add BB_CLAN to BACKUP_JOBS to enable)
# BB_CLAN_BACKUP_ENABLED=false
# BB_CLAN_BACKUP_DB_PATH=/root/BotsRepo/bb_clan_moderator_bot/data/bot.db
# BB_CLAN_BACKUP_LOCAL_DIR=/var/backups/bb-clan
# BB_CLAN_BACKUP_GDRIVE_FOLDER_ID=YOUR_FOLDER_ID
# Path to Google credentials JSON: service account key OR OAuth refresh token file.
# BB_CLAN_BACKUP_GDRIVE_SERVICE_ACCOUNT=/root/BotsRepo/deploy/secrets/gdrive-oauth.json
# BB_CLAN_BACKUP_RETENTION_DAYS=7
