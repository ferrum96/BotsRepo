[Unit]
Description=AstroStone partner demo (NestJS + PGlite)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/BotsRepo/fl_5521193
EnvironmentFile=-/root/BotsRepo/deploy/ports.env
EnvironmentFile=-/root/BotsRepo/fl_5521193/.env
Environment=NODE_ENV=production
Environment=DEMO_MODE=true
Environment=API_PORT=5521
Environment=MESSAGING_PROVIDER=stub
ExecStart=/usr/bin/npm run start -w @astrostone/api
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
