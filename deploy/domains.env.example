# Optional domains for Caddy setup script (static IP friendly).
# Copy to deploy/domains.env and adjust values.
#
# Main gateway domain. If empty, pass it via:
#   --gateway-domain your.domain
# or:
#   --subdomain your-duckdns-name
#
# GATEWAY_DOMAIN="mybots.duckdns.org"
#
# Per-service dedicated domains (optional).
# If set, Caddy creates additional host-based reverse proxy blocks.
# Leave empty to use only path-based routing on GATEWAY_DOMAIN.

GATEWAY_DOMAIN="kanban-board.duckdns.org"
# Empty = kanban is default site on gateway root https://GATEWAY/
SERVICE_DOMAIN_KANBAN=""
SERVICE_DOMAIN_BB_CLAN="bb-clan.duckdns.org"
SERVICE_DOMAIN_FKANDU="fkandu.duckdns.org"
# Optional separate hosts (пусто = path /api /files на gateway при ENABLE_FKANDU=1)
# SERVICE_DOMAIN_FKANDU_API=""
# SERVICE_DOMAIN_FKANDU_FILES=""

# Optional ACME account email (used by deploy.sh / duckdns-caddy-setup.sh)
# ACME_EMAIL="you@example.com"

# FKandu сервисы сейчас в deploy/systemd/disabled/.
# Caddy host/routes для FKandu создаются только при ENABLE_FKANDU=1:
#   ENABLE_FKANDU=1 CADDY_SETUP=1 ./deploy/deploy.sh
# Чтобы снова гонять unit'ы — см. deploy/systemd/disabled/README.md
