# MAX
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_WEBHOOK_URL=https://example.com/api/max/webhook
MAX_WEBHOOK_SECRET=
MAX_CHANNEL_ID=
ALLOWED_MAX_USER_IDS=123456789,987654321

# Development only. Do not enable in production.
MAX_USE_LONG_POLLING=false

# Database
DATABASE_URL=postgresql+asyncpg://maxbot:maxbot@postgres:5432/maxbot

# AI (OpenAI Responses API or compatible)
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Shop
SHOP_NAME=MAX Shop
TIMEZONE=Europe/Vilnius
SHOW_STOCK=true
MAX_CSV_SIZE_MB=10
MAX_IMAGE_SIZE_MB=10

# HTTP
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=30
